{
  "name": "wawasan-authentic-film",
  "private": true,
  "version": "0.4.0",
  "scripts": {
    "render:film": "remotion render src/index.ts WawasanFilm out/wawasan-studio-film.mp4 --codec=h264 --crf=18 --concurrency=2",
    "render:proof": "remotion render src/index.ts AuthenticProof out/authentic-proof.mp4 --codec=h264 --crf=20 --concurrency=2",
    "render:master": "remotion render src/index.ts MasterCut out/wawasan-master-cut.mp4 --codec=h264 --crf=18 --concurrency=2",
    "render:3d-smoke": "remotion still src/index.ts Wawasan3DSmoke out/wawasan-3d-smoke.png --frame=28 --gl=swangle",
    "render:fx": "remotion render src/index.ts WawasanFXShowcase out/wawasan-visual-effects.mp4 --codec=h264 --crf=22 --concurrency=2",
    "render:addons": "remotion render src/index.ts WawasanMotionAddonsSmoke out/wawasan-addons-smoke.mp4 --codec=h264 --crf=22 --concurrency=2",
    "prepare:sfx": "python3 ../../scripts/generate-wawasan-sfx.py --output public/audio/sfx",
    "check:sfx": "python3 ../../scripts/verify-wawasan-sfx.py --input public/audio/sfx",
    "render:sfx": "remotion render src/index.ts WawasanSfxPreview out/wawasan-sfx-preview.mp4 --codec=h264 --crf=22 --concurrency=2",
    "render:loop": "remotion render src/index.ts WawasanSeamlessLoop out/wawasan-seamless-loop.mp4 --codec=h264 --crf=18 --concurrency=2 --gl=swangle",
    "verify:loop": "python3 ../../scripts/verify-render-loop.py --input out/wawasan-seamless-loop.mp4 --fps 30 --frames 120 --width 1080 --height 1920 --seam --expected-audio none --report out/loop-render-qc/qa-report.json"
  },
  "dependencies": {
    "remotion": "4.0.545",
    "@remotion/cli": "4.0.545",
    "@remotion/three": "4.0.545",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@react-three/fiber": "9.8.1",
    "three": "0.187.0",
    "@remotion/paths": "4.0.545",
    "@remotion/shapes": "4.0.545",
    "@remotion/lottie": "4.0.545",
    "lottie-web": "5.13.0"
  },
  "devDependencies": {
    "@types/three": "0.187.0"
  }
}
